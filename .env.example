# Copy to .env and fill in.

# Flutterwave public key (safe to expose in the browser)
VITE_FLW_PUBLIC_KEY=

# Backend API base URL, no trailing slash
VITE_API_BASE=https://dhunobeats.com/api

# Where uploaded images (hotel/city photos) are served from
VITE_ASSET_BASE=https://stay9jahotels.com

# Google sign-in OAuth client ID (same value as GOOGLE_CLIENT_ID on the API).
# Leave empty to show the Google button as "coming soon".
VITE_GOOGLE_CLIENT_ID=
